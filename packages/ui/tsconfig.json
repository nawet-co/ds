{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@nawet/ui/*": ["./src/*"],
      "@/components/ui/*": ["./src/components/*"],
      "@/components/*": ["./src/components/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/lib/icons": ["./src/icons.tsx"],
      "@/lib/*": ["./src/lib/*"]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
