{
  "name": "@nawet/ds-core",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/styles/globals.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./globals.css": "./src/styles/globals.css",
    "./styles.css": "./src/styles/globals.css",
    "./recipes/*": {
      "types": "./src/recipes/*.ts",
      "import": "./src/recipes/*.ts"
    },
    "./tokens": {
      "types": "./src/tokens.ts",
      "import": "./src/tokens.ts"
    },
    "./utils": {
      "types": "./src/utils.ts",
      "import": "./src/utils.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "tokens:generate": "node --experimental-strip-types scripts/generate-tokens.ts",
    "tokens:check": "node --experimental-strip-types scripts/generate-tokens.ts --check",
    "test": "node --test --experimental-strip-types scripts/*.test.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "postcss": "^8.5.32",
    "typescript": "~6.0.2"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  }
}
