{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "esModuleInterop": true
  },
  "include": ["src", "tsdown.config.ts"],
  "exclude": ["node_modules", "dist"]
}
