---
import Layout from "../layouts/Layout.astro";
import { FoundationLab } from "../components/foundation-lab";
---

<Layout title="Nawet DS · Foundations">
  <div class="container mx-auto max-w-5xl px-4 py-8">
    <header class="mb-10 space-y-2">
      <p class="text-xs font-medium tracking-widest text-neutral-500 uppercase">
        Nawet DS
      </p>
      <h1 class="text-3xl font-semibold tracking-tight">Foundations</h1>
      <p class="max-w-2xl text-sm text-neutral-400">
        Tokens, type, state, and runtime configuration. Use the controls to
        inspect theme, direction, density, and reduced motion.
      </p>
    </header>
    <FoundationLab client:load />
  </div>
</Layout>
