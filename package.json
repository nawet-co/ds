{
  "name": "design-system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "dev:web": "vp run --filter web dev:bare",
    "deploy": "vp run --filter @design-system/infra deploy",
    "destroy": "vp run --filter @design-system/infra destroy",
    "env:generate": "varlock codegen --path ./apps/web/",
    "postinstall": "varlock codegen --path ./apps/web/",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@design-system/config": "workspace:*",
    "@types/node": "^26.4.1",
    "husky": "latest",
    "lefthook": "latest",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "rolldown": "1.2.15",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "varlock": "catalog:",
    "vite-plus": "1.4.0"
  },
  "packageManager": "pnpm@11.8.0"
}
