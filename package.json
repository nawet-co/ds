{
  "name": "@nawet/ds",
  "private": true,
  "license": "MIT",
  "repository": "github:nawet-co/ds",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types && pnpm tokens:check && pnpm test && pnpm --filter @nawet/ds-react check-client-boundaries",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "dev:showcase": "vp run --filter showcase dev:bare",
    "deploy": "vp run --filter @nawet/infra deploy",
    "destroy": "vp run --filter @nawet/infra destroy",
    "tokens:generate": "pnpm --filter @nawet/ds-core tokens:generate",
    "tokens:check": "pnpm --filter @nawet/ds-core tokens:check",
    "test": "pnpm --filter @nawet/ds-core test && pnpm --filter @nawet/ds-react test && pnpm --filter @nawet/ds-cli test",
    "env:generate": "varlock codegen --path ./apps/showcase/",
    "postinstall": "varlock codegen --path ./apps/showcase/",
    "clean:lockfile": "pnpm clean --lockfile && pnpm install",
    "deps:update": "pnpm up -r -L",
    "fix": "ultracite fix",
    "knip": "knip",
    "cli:build": "pnpm --filter @nawet/ds-cli build",
    "cli:dev": "pnpm --filter @nawet/ds-cli dev"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@nawet/config": "workspace:*",
    "@types/node": "^26.4.1",
    "knip": "^6.44.1",
    "lefthook": "latest",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "rolldown": "1.2.15",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "varlock": "catalog:",
    "vite-plus": "1.4.0"
  },
  "packageManager": "pnpm@12.18.0"
}
